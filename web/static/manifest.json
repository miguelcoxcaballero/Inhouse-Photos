{
  "background_color": "#120c08",
  "description": "Your private Inhouse photo and video library.",
  "dir": "auto",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "icons": [
    {
      "purpose": "any",
      "sizes": "192x192",
      "src": "manifest-icon-192.maskable.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "512x512",
      "src": "manifest-icon-512.maskable.png",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
